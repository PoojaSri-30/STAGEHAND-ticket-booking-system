# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (SQLite file path)
DB_PATH=./data/ticketing.db

# Seat hold TTL, in seconds (how long a seat stays "held" before auto-release)
SEAT_HOLD_TTL_SECONDS=600

# Waitlist offer TTL, in seconds (how long a waitlisted customer has to complete booking)
WAITLIST_OFFER_TTL_SECONDS=900

# How often (ms) the background scheduler sweeps for expired holds/offers
SCHEDULER_INTERVAL_MS=15000

# Frontend URL (used in emails for links)
FRONTEND_URL=http://localhost:5173

# Email (SMTP). Leave blank to auto-use an Ethereal test account (free, prints preview URL to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ticket Booking <no-reply@ticketbooking.dev>"
